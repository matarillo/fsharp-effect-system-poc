    <Compile Include="StaticRow.fs" />
    <Compile Include="RecordEnv.fs" />
    <Compile Include="Advanced.fs" />
    <Compile Include="Bench.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EffectSystem\EffectSystem.fsproj" />
    <ProjectReference Include="..\..\src\EffectSystem.Plus\EffectSystem.Plus.fsproj" />
  </ItemGroup>

</Project>
